# Feel It - backend environment template. Copy to .env and fill in the values.

# ---- App ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=feelit

# ---- Auth ----
JWT_SECRET=<long-random-string>
JWT_EXPIRES_DAYS=7
# Firebase project used for Google sign-in
FIREBASE_PROJECT_ID=<your-firebase-project-id>

# ---- AI models ----
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Live travel data ----
GEOAPIFY_API_KEY=
TAVILY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ---- Limits ----
AI_RATE_LIMIT_PER_HOUR=30

# ---- Email (Brevo): the trip reminder sent the evening before a trip ----
# Leave the key empty to switch reminders off. The sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Feel It
# Lets an outside scheduler trigger the reminder run: POST /api/internal/reminders with header X-Cron-Secret
CRON_SECRET=<long-random-string>
# Optional: website address used in email links (defaults to the first CORS origin)
APP_URL=
