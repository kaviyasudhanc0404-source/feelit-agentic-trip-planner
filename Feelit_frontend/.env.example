# Backend API address (set this to your FastAPI Cloud URL + /api in Vercel)
VITE_API_URL=http://localhost:8000/api

# Firebase (Google sign-in). These are public identifiers, safe to ship in the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
